# Turn2Law platform environment contract (decision C1)
# Copy to the production repo as .env.example. NEVER commit real values.
# Keys are supplied by the founder per phase: Supabase -> email -> AI -> Razorpay.
# Until a key exists, the matching adapter runs in labelled DEV mode.

# --- Core (Phase 1) ---
APP_URL=http://localhost:3000
SESSION_SECRET=change-me

# Supabase (first key set to be supplied)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Email (Phase 1, adapter until key) ---
EMAIL_PROVIDER=resend
EMAIL_FROM="Turn2Law <no-reply@turn2law.in>"
EMAIL_PROVIDER_API_KEY=

# --- AI (D3: provider must have no-training terms; flagged until founder confirms) ---
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL_RESEARCH=
AI_PROVIDER_MODEL_DRAFTING=
AI_PROVIDER_NO_TRAINING_CONFIRMED=false

# --- Payments (Phase 4; never live without these, test keys first) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Optional later phases ---
WHATSAPP_PROVIDER_API_KEY=
ESIGN_PROVIDER_API_KEY=
AUDIT_WEBHOOK_URL=
